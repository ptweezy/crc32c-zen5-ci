index fb07ed449ae4..296cb45ea7d2 100644
--- a/lib/crc/x86/crc32.h
+++ b/lib/crc/x86/crc32.h
@@ -85,10 +85,44 @@ static inline u32 crc32c_arch(u32 crc, const u8 *p, size_t len)
 	 * combination would be inefficient here.
 	 */
 
-	for (num_longs = len / sizeof(unsigned long);
-	     num_longs != 0; num_longs--, p += sizeof(unsigned long))
-		asm(CRC32_INST : "+r" (crc) : ASM_INPUT_RM (*(unsigned long *)p));
+	num_longs = len / sizeof(unsigned long);
+	if (num_longs != 0) {
+		const u8 *end = p + len;
+		const size_t rem = len % sizeof(unsigned long);
+
+		do {
+			asm(CRC32_INST : "+r" (crc) : ASM_INPUT_RM (*(unsigned long *)p));
+			p += sizeof(unsigned long);
+		} while (--num_longs != 0);
+
+		if (rem != 0) {
+			/*
+			 * Do the remaining 1 to sizeof(long) - 1 bytes all at
+			 * once, rather than testing the bits of 'rem' to do
+			 * them a dword, a word and a byte at a time.  Those
+			 * tests mispredict when the caller's lengths vary.
+			 *
+			 * Updating a CRC with k bytes shifts it right by 8*k
+			 * bits and XORs in the CRC, from zero, of those bytes
+			 * XORed with the bits that got shifted out.  A single
+			 * CRC32 instruction computes the latter if the bytes
+			 * are at the end of a long, as the zero bytes ahead of
+			 * them leave a zero CRC unchanged.  The last long of
+			 * the data already has the bytes at its end.
+			 */
+			const unsigned int shift = BITS_PER_LONG - 8 * rem;
+			unsigned long tail =
+				*(const unsigned long *)(end - sizeof(unsigned long));
+			u32 tail_crc = 0;
+
+			tail = ((tail >> shift) ^ crc) << shift;
+			asm(CRC32_INST : "+r" (tail_crc) : ASM_INPUT_RM (tail));
+			crc = ((unsigned long)crc >> (8 * rem)) ^ tail_crc;
+		}
+		return crc;
+	}
 
+	/* The data is shorter than a long, so there's no whole long to load. */
 	if (sizeof(unsigned long) > 4 && (len & 4)) {
 		asm("crc32l %1, %0" : "+r" (crc) : ASM_INPUT_RM (*(u32 *)p));
