diff --git a/lib/crc/x86/crc32c-mixed.S b/lib/crc/x86/crc32c-mixed.S
new file mode 100644
index 000000000000..395ecb307952
--- /dev/null
+++ b/lib/crc/x86/crc32c-mixed.S
@@ -0,0 +1,204 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+//
+// CRC32C using the crc32q and VPCLMULQDQ instructions together (x86_64)
+//
+// On a CPU where crc32q and VPCLMULQDQ don't compete for the same execution
+// resources, code that uses only one of them leaves the other idle.  This
+// file uses both at once.  The data is laid out as
+//
+//	[ V ][ lane 0 ][ lane 1 ][ lane 2 ][ lane 3 ][ F ]
+//
+// and processed in a single pass:
+//
+// - V is 128*n bytes.  Two zmm registers fold it 128 bytes at a time, as in
+//   crc-pclmul-template.S.  This leaves eight 128-bit polynomials.
+//
+// - Each lane is q qwords and gets its own crc32q dependency chain.  Each
+//   chain advances 3 qwords in the time it takes to fold 128 bytes of V, so
+//   that's how the data is divided: q = 3*n + e, where e covers what n
+//   iterations of 128 + 4*24 = 224 bytes leave over.  Up to 3 further qwords,
+//   t, go to the front of lane 0, where all they change is how far V is
+//   from F.
+//
+// - F is the last 16 bytes.
+//
+// At the end, each of the eight polynomials from V and each of the CRCs of
+// lanes 0-2 is multiplied by the power of x that moves it to where F is, and
+// all of them are added to F.  Lane 3's crc32q chain then just continues
+// through F and yields the CRC of everything.
+//
+// Every multiplier needed comes from one table of M(d) = x^(64*d + 31) mod G;
+// see crc32c-mixed-consts.h for what M(d) does.
+//
+// The stream counts and the 224-byte iteration were chosen on AMD Zen 5.
+
+#include <linux/linkage.h>
+
+// Bytes per iteration of the main loop: 128 from V and 24 from each lane
+#define BYTES_PER_ITER	224
+
+// The table holds M(TOP) down to M(0).
+#define TOP		255
+
+// Arguments
+#define CRC		%edi
+#define BUF		%rsi
+#define LEN		%rdx
+#define CONSTS		%rcx
+
+// Locals.  Note which ones take over an argument's register.
+#define C0		%r8	// CRC of lane 0
+#define C1		%r9	// CRC of lane 1
+#define C2		%r10	// CRC of lane 2
+#define C3		%rax	// CRC of lane 3, then of everything
+#define LP		%r11	// Position in lane 0
+#define LQ		%rdx	// Bytes per lane (was LEN)
+#define LQ3		%rdi	// 3*LQ (was CRC)
+#define EXTRA		%ecx	// Qwords per lane before the loop (was CONSTS)
+#define ITERS		%ebx	// Main loop iterations
+
+// Carrylessly multiply the first and second qword of each 128-bit lane of \acc
+// by those of \mults, and store the sum of the two products and \addend in
+// \acc.  I.e., move the polynomials in \acc and add them to \addend.
+.macro	_fold	acc, mults, addend, tmp
+	vpclmulqdq	$0x00, \mults, \acc, \tmp
+	vpclmulqdq	$0x11, \mults, \acc, \acc
+	vpternlogq	$0x96, \addend, \tmp, \acc
+.endm
+
+// Advance each lane's CRC by the qword at \offset from that lane's position.
+.macro	_crc_lanes	offset
+	crc32q		\offset(LP), C0
+	crc32q		\offset(LP,LQ), C1
+	crc32q		\offset(LP,LQ,2), C2
+	crc32q		\offset(LP,LQ3), C3
+.endm
+
+// u32 crc32c_mixed_avx512(u32 crc, const u8 *p, size_t len, const u32 *consts);
+//
+// |len| must be a multiple of 8 that is at least 512 and at most 4096, the
+// most that the table of multipliers covers.  |consts| is that table,
+// crc32_lsb_0x82f63b78_mixed_consts.
+//
+// Requires SSE4.2, VPCLMULQDQ, AVX512BW and AVX512VL.
+SYM_FUNC_START(crc32c_mixed_avx512)
+	push		%rbx
+
+	// n = (len - 16) / 224.  Multiplying by ceil(2^24 / 224) and shifting
+	// gives the exact quotient for any length allowed here.
+	lea		-16(LEN), %eax
+	imul		$74899, %eax, ITERS
+	shr		$24, ITERS
+
+	// Of the 0-27 qwords which that leaves over, every lane gets e and
+	// lane 0 gets the remaining t.
+	imul		$BYTES_PER_ITER, ITERS, %r8d
+	sub		%r8d, %eax
+	shr		$3, %eax
+	mov		%eax, %r10d
+	and		$3, %r10d		// t.  In C2's register; see below.
+	shr		$2, %eax		// e
+	lea		(%rbx,%rbx,2), %edx	// 3*n
+	add		%eax, %edx		// q = 3*n + e.  LEN is gone now.
+
+	// The last polynomial from V ends m = 4*q + t qwords before F starts,
+	// so moving it onto F takes M(m + 2) and M(m + 1).  Each polynomial
+	// before it is 2 qwords further away.  So the eight of them need
+	// M(m + 16) through M(m + 1), which the table has in exactly that
+	// order.
+	lea		(%r10,%rdx,4), %r8d	// m
+	neg		%r8			// -m
+	vpmovzxdq	4*(TOP-16)(CONSTS,%r8,4), %zmm4
+	vpmovzxdq	4*(TOP-8)(CONSTS,%r8,4), %zmm5
+
+	// Lane i's CRC stands in for lane i when it's placed in the first 4
+	// bytes of an otherwise-zero 16 bytes following that lane.  Those 16
+	// bytes end q*(3 - i) qwords before F does, which takes M(q*(3 - i)).
+	mov		%edx, %r9d
+	neg		%r9			// -q
+	vmovd		4*TOP(CONSTS,%r9,4), %xmm8
+	vmovd		4*TOP(CONSTS,%r9,8), %xmm7
+	lea		(%r9,%r9,2), %r9	// -3*q
+	vmovd		4*TOP(CONSTS,%r9,4), %xmm6
+
+	// Folding V takes M(16) and M(15) in every 128-bit lane.
+	vpmovzxdq	4*(TOP-16)(CONSTS), %xmm2
+	vshufi64x2	$0, %zmm2, %zmm2, %zmm2
+
+	// Load the first 128 bytes of V, adding the CRC so far to the start.
+	// Since those 128 bytes aren't folded, the main loop runs n - 1 times,
+	// which leaves each lane 3 + e qwords to do before it.
+	vmovd		CRC, %xmm3
+	vpxorq		0*64(BUF), %zmm3, %zmm0
+	vmovdqu64	1*64(BUF), %zmm1
+	add		$128, BUF
+	lea		3(%rax), EXTRA
+	dec		ITERS
+
+	// The lanes follow V, and their CRCs start at zero.
+	mov		ITERS, %r11d
+	shl		$7, LP
+	add		BUF, LP			// BUF + 128*(n - 1)
+	shl		$3, LQ			// 8*q
+	lea		(LQ,LQ,2), LQ3
+	xor		%r8d, %r8d		// C0
+	xor		%r9d, %r9d		// C1
+	xor		%eax, %eax		// C3
+
+	// Do lane 0's t qwords.  Counting them in C2's register leaves C2
+	// zero, same as the other CRCs.
+	test		%r10d, %r10d
+	jz		.Lall_lanes
+.Llane0_only:
+	crc32q		(LP), C0
+	add		$8, LP
+	dec		%r10d
+	jnz		.Llane0_only
+
+.Lall_lanes:
+	_crc_lanes	0
+	add		$8, LP
+	dec		EXTRA
+	jnz		.Lall_lanes
+
+.Lmain_loop:
+	_fold		%zmm0, %zmm2, 0*64(BUF), %zmm3
+	_fold		%zmm1, %zmm2, 1*64(BUF), %zmm3
+	_crc_lanes	0*8
+	_crc_lanes	1*8
+	_crc_lanes	2*8
+	add		$128, BUF
+	add		$24, LP
+	dec		ITERS
+	jnz		.Lmain_loop
+
+	// LP has reached lane 1, so F is at (LP,LQ3).  Move the CRCs of lanes
+	// 0-2 to F and add them to it.
+	vmovq		C0, %xmm3
+	vmovq		C1, %xmm9
+	vmovq		C2, %xmm10
+	vpclmulqdq	$0x00, %xmm6, %xmm3, %xmm3
+	vpclmulqdq	$0x00, %xmm7, %xmm9, %xmm9
+	vpclmulqdq	$0x00, %xmm8, %xmm10, %xmm10
+	vpternlogq	$0x96, %xmm10, %xmm9, %xmm3
+	vpxor		(LP,LQ3), %xmm3, %xmm3
+
+	// Likewise the polynomials from V, then add the four 128-bit lanes
+	// that result.
+	_fold		%zmm1, %zmm5, %zmm3, %zmm9
+	_fold		%zmm0, %zmm4, %zmm1, %zmm9
+	vextracti64x4	$1, %zmm0, %ymm1
+	vpxor		%ymm1, %ymm0, %ymm0
+	vextracti128	$1, %ymm0, %xmm1
+	vpxor		%xmm1, %xmm0, %xmm0
+
+	// Lane 3 finishes the job.
+	vmovq		%xmm0, %r8
+	vpextrq		$1, %xmm0, %r9
+	crc32q		%r8, C3
+	crc32q		%r9, C3
+
+	vzeroupper
+	pop		%rbx
+	RET
+SYM_FUNC_END(crc32c_mixed_avx512)
